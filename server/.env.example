PORT=5000
DB_DIALECT=sqlite
SQLITE_STORAGE=data/calendar.sqlite
SECRET_KEY=replace-with-a-random-secret

# Local password recovery messages are saved in server/data/mail/ (never in production).
MAIL_TRANSPORT=outbox
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Hosted Google mail: see integrations/google-mail/README.md.
# MAIL_TRANSPORT=google
# GOOGLE_MAIL_URL=https://script.google.com/macros/s/deployment-id/exec
# GOOGLE_MAIL_SECRET=replace-with-a-random-32-byte-hex-secret
# PASSWORD_RESET_URL="https://domalega.github.io/diploma/#/reset-password"

# To use PostgreSQL, set DB_DIALECT=postgres and configure:
# DB_NAME=diploma
# DB_USER=postgres
# DB_PASSWORD=replace-with-your-local-password
# DB_HOST=localhost
# DB_PORT=5432
# Cloud PostgreSQL alternative (Neon):
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# DB_SSL=true
# CLIENT_ORIGIN=https://domalega.github.io
